{
  "manifest_version": 3,
  "name": "ChatGPT 提示词快捷栏",
  "version": "1.0.2",
  "description": "在 ChatGPT 页面右侧保存、管理并一键发送常用提示词。",
  "permissions": ["storage"],
  "action": {
    "default_title": "ChatGPT 提示词快捷栏",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "src/prompt-core.js",
        "src/panel-style.js",
        "src/content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
