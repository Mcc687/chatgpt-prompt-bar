{
  "name": "chatgpt-prompt-bar",
  "version": "1.0.2",
  "private": true,
  "type": "commonjs",
  "description": "A lightweight local-first prompt sidebar for the ChatGPT website.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mcc687/chatgpt-prompt-bar.git"
  },
  "homepage": "https://github.com/Mcc687/chatgpt-prompt-bar#readme",
  "bugs": {
    "url": "https://github.com/Mcc687/chatgpt-prompt-bar/issues"
  },
  "keywords": [
    "chatgpt",
    "chrome-extension",
    "prompt-manager",
    "manifest-v3"
  ],
  "scripts": {
    "test": "node --test tests/manifest.test.cjs tests/prompt-core.test.cjs",
    "check": "node --check src/prompt-core.js && node --check src/panel-style.js && node --check src/content.js && node --check popup.js && npm test",
    "package": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package.ps1"
  },
  "engines": {
    "node": ">=20"
  }
